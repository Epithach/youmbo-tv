{
  "name": "youmbo-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Client IPTV léger pour Samsung TV (Tizen) et navigateur",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "diagnose": "node tools/diagnose-playlist.ts"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "mpegts.js": "^1.8.2",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-solid": "^0.19.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
