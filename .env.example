# Copie ce fichier en `.env.local` (ignoré par Git) et mets-y ton lien M3U.
# Il sert uniquement en dev, pour pré-charger la playlist au démarrage.
M3U_URL=

# User-Agent envoyé au fournisseur par le proxy de dev. Si ta playlist est
# refusée (403, 884…), lance `npm run diagnose` pour trouver celui qu'il accepte.
# Valeurs : vlc (défaut), tivimate, smarters, okhttp, chrome, tizen, aucun,
# ou un User-Agent complet.
PROXY_USER_AGENT=
